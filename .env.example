SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
TIME_ZONE=Asia/Kolkata

# Demo toggle
ALLOW_ADMIN_SIGNUP=True

# PostgreSQL via DATABASE_URL (recommended for Railway)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/team_task_manager

# Alternative explicit PostgreSQL settings
POSTGRES_DB=team_task_manager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Production HTTPS hardening
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
